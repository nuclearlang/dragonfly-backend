# Generated by NuclearLang for Dragonfly. Do not edit: it changes when the .nuc files change.
# The dependencies are the runtime and the plugins config.nuc enables (plugins(...)).
[project]
name = "{{project}}"
version = "{{app.version}}"
{{#app.description}}
description = "{{app.description}}"
{{/app.description}}
requires-python = ">=3.12"
dependencies = [
    "dragonfly-py",
    "uvicorn>=0.30",
{{#plugins.packages}}
    "{{name}}{{version}}",
{{/plugins.packages}}
{{#dependencies}}
    "{{name}}{{#path}} @ file://{{path}}{{/path}}{{^path}}{{version}}{{/path}}",
{{/dependencies}}
]

[project.optional-dependencies]
test = ["dragonfly-py[test]"]

[tool.pytest.ini_options]
pythonpath = ["."]
python_files = ["*_test.py", "test_*.py"]
asyncio_mode = "auto"

[tool.pyright]
typeCheckingMode = "strict"
pythonVersion = "3.12"
