itions."},{"name":"start","kind":"method","params":[],"returns":"any","doc":"Connect to Kafka cluster. This will:"},{"name":"stop","kind":"method","params":[],"returns":"any","doc":"Close the consumer, while waiting for finalizers:"},{"name":"subscribe","kind":"method","params":[{"name":"topics","type":"any","optional":true},{"name":"pattern","type":"any","optional":true,"default":"None"},{"name":"listener","type":"any","optional":true,"default":"None"}],"returns":"any","doc":"Subscribe to a list of topics, or a topic regex pattern."},{"name":"subscription","kind":"method","params":[],"returns":"any","doc":"Get the current topics subscription."},{"name":"topics","kind":"method","params":[],"returns":"any","doc":"Get all topics the user is authorized to view."},{"name":"unsubscribe","kind":"method","params":[],"returns":"any","doc":"Unsubscribe from all topics and clear all assigned partitions."}],"doc":"A client that consumes records from a Kafka cluster."},
